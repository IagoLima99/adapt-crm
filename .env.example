# Ambiente compartilhado pela API e pelo worker.
APP_ENV=local

# Processo HTTP local.
API_HOST=127.0.0.1
API_PORT=8000

# Endpoint externo consumido pela API.
DATABASE_URL=postgresql+asyncpg://adaptcrm:adaptcrm@localhost:5432/adaptcrm
# Optional SQLAlchemy pool tuning.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Endpoint e registro técnico do worker Temporal.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=adaptcrm-local

# Origem pública da API para web e smoke local.
VITE_API_BASE_URL=http://localhost:8000
